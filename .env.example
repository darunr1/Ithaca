# No credentials needed: npm install && npm run dev
PORT=3000
HOST=127.0.0.1
# demo keeps the explicitly fictional local identity picker; supabase protects production.
AUTH_MODE=demo
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# demo = read-only fictional fixtures; atlas = real persistence, never a silent fallback
DATA_MODE=demo
MONGODB_URI=
MONGODB_DB=ithaca_demo
# Explicitly select live to send notes to Gemini. Never put keys in frontend code.
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Conventional Node hosts: set HOST=0.0.0.0 and use their PORT.
# Vercel invokes the exported Express app; leave HOST and PORT unset there.

# Athene never uses mock AI or demo persistence. Enable after configuring live services.
ATHENE_ENABLED=false
# Separate from the foundation's extraction model to avoid changing teammate AI workflows.
ATHENE_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
MONGODB_VECTOR_INDEX=athene_chunks_vector
ATHENE_CHUNK_SIZE=1400
ATHENE_CHUNK_OVERLAP=200
ATHENE_TOP_K=6
ATHENE_MIN_SCORE=0.65
# Supabase uses asymmetric signing keys. The JWT subject maps to members.id;
# only RS256/ES256 tokens with the configured issuer/audience are accepted.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
# Optional LOCAL fictional demo only: random 32+ character bearer token.
# Requires HOST=127.0.0.1, a database ending _demo, NODE_ENV != production.
# Never configure ATHENE_DEV_TOKEN in Vercel or another public deployment.
ATHENE_DEV_TOKEN=
ATHENE_DEV_MEMBER_ID=member-iris
NODE_ENV=development
# Opt-in real integration test; uses existing authorized club/member and cleans its own documents.
ATHENE_INTEGRATION=false
ATHENE_TEST_PROJECT_ID=club-rocketry
ATHENE_TEST_BEARER_TOKEN=
