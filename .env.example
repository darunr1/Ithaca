# No credentials needed: npm install && npm run dev
PORT=3000
HOST=127.0.0.1
# demo = read-only fictional fixtures; atlas = real persistence, never a silent fallback
DATA_MODE=demo
MONGODB_URI=
MONGODB_DB=ithaca_demo
# Explicitly select live to send notes to Gemini. Never put keys in frontend code.
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Deployment: set HOST=0.0.0.0 and PORT to the host-provided value.
